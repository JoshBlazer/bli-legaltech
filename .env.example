# Copy to .env and fill in. .env is gitignored and Claude cannot read it.
# /approve trims this list to what this project needs.
# Every paid key: set a spend cap in the provider dashboard.

# --- Supabase ---
SUPABASE_PROJECT_REF=          # project settings → General
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web3 (TESTNET BURNER WALLET ONLY) ---
ALCHEMY_API_KEY=               # dashboard.alchemy.com → app → API key
ETHERSCAN_API_KEY=             # etherscan.io/myapikey (works across chains via v2 API)
DEPLOYER_PRIVATE_KEY=          # from `cast wallet new` — NEVER a wallet with real funds

# --- AI track (sponsor key, spend-capped) ---
AI_API_KEY=

# --- Docs ---
CONTEXT7_API_KEY=              # optional, higher rate limits

# --- Discord announcements (see SETUP.md §6) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=           # comma-separated channel IDs in YOUR server
