# Attestry dApp — environment variable NAMES only. Copy to .env.local and fill in.
# .env* is gitignored. No secrets are ever required for the keyless read path.

# Deployed ComplianceRegistry v2 address (from workstream A's deployments/ output).
# Until this is set, lib/contract.ts uses a clearly-marked placeholder.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Target chain id. Default 11155111 (Sepolia). Use 31337 for a local anvil chain.
NEXT_PUBLIC_CHAIN_ID=

# Public RPC endpoint for keyless reads. A default public Sepolia RPC is used if unset.
# (Optional) point this at your own provider if you prefer.
NEXT_PUBLIC_RPC_URL=

# Block explorer base URL (no trailing slash). Defaults per chain id if unset.
NEXT_PUBLIC_EXPLORER_BASE=

# Earliest block to scan for events (set to the deploy block to keep getLogs fast).
NEXT_PUBLIC_DEPLOY_BLOCK=
